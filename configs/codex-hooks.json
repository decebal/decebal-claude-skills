{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": "codex-guard infra-guard", "timeout": 10 },
          { "type": "command", "command": "codex-guard bash-hygiene", "timeout": 5 },
          { "type": "command", "command": "codex-guard pr-guard", "timeout": 10 }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "codex-guard prompt-number", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "codex-guard comment-hygiene", "timeout": 5 }
        ]
      }
    ]
  }
}
